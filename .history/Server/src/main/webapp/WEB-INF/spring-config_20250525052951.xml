<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/mvc
                           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <mvc:annotation-driven />
    <context:component-scan base-package="com.qhoang.connectify" />
    <context:component-scan base-package="com.qhoang.connectify.utils" />
    <mvc:resources mapping="/resources/**" location="/resources/" />

    <!-- Enhanced CORS Configuration for Frontend -->
    <mvc:cors>
        <mvc:mapping path="/admin/**"
                     allowed-origins="http://localhost:8000,http://127.0.0.1:8000"
                     allowed-methods="GET,POST,PUT,DELETE,OPTIONS"
                     allowed-headers="Content-Type,Authorization,X-Requested-With,Accept,Origin"
                     allow-credentials="true"
                     max-age="3600" />
        <mvc:mapping path="/auth/**"
                     allowed-origins="http://localhost:8000,http://127.0.0.1:8000"
                     allowed-methods="GET,POST,PUT,DELETE,OPTIONS"
                     allowed-headers="Content-Type,Authorization,X-Requested-With,Accept,Origin"
                     allow-credentials="true"
                     max-age="3600" />
        <mvc:mapping path="/electronics/**"
                     allowed-origins="http://localhost:8000,http://127.0.0.1:8000"
                     allowed-methods="GET,POST,PUT,DELETE,OPTIONS"
                     allowed-headers="Content-Type,Authorization,X-Requested-With,Accept,Origin"
                     allow-credentials="true"
                     max-age="3600" />
        <mvc:mapping path="/**"
                     allowed-origins="http://localhost:8000,http://127.0.0.1:8000"
                     allowed-methods="GET,POST,PUT,DELETE,OPTIONS"
                     allowed-headers="Content-Type,Authorization,X-Requested-With,Accept,Origin"
                     allow-credentials="true"
                     max-age="3600" />
    </mvc:cors>
</beans>
